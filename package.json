{
  "name": "multi-vendor-marketplace-mvp",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/migrator"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "lint": "npm run lint -w apps/api && npm run lint -w apps/web",
    "format:check": "node scripts/check-format.mjs",
    "env:example:check": "node scripts/check-env-example.mjs",
    "typecheck": "npm run typecheck -w apps/api && npm run typecheck -w apps/web",
    "test": "npm run test -w apps/api",
    "db:generate": "npm run prisma:generate -w apps/api",
    "db:migrate": "npm run prisma:migrate -w apps/api",
    "db:deploy": "npm run prisma:deploy -w apps/api",
    "db:seed": "npm run prisma:seed -w apps/api",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium --only-shell"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10"
  }
}
