NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
# Trust only the single controlled reverse proxy when deploying behind it; never trust arbitrary forwarded headers.
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace?schema=public
SESSION_COOKIE_NAME=marketplace_session
SESSION_TTL_DAYS=14
PASSWORD_PEPPER=replace-with-long-random-value
# Optional but recommended: a separate stable secret (32+ characters) for encrypting OAuth provider credentials.
SOCIAL_LOGIN_ENCRYPTION_KEY=replace-with-a-different-long-random-server-only-secret
# Optional local/deployment secret for encrypting seller bank/e-wallet details.
PAYOUT_ENCRYPTION_KEY=replace-with-a-long-random-server-only-secret
DROPSHIPPING_ENCRYPTION_KEY=replace-with-a-different-long-random-server-only-secret
# Keep real-money wallet movement disabled until provider, compliance, and reconciliation gates pass.
MONEY_MOVEMENT_HARD_DISABLED=true
WALLET_FUNDING_PROVIDER_READY=false
# Sandbox-only provider flow requires NODE_ENV=test, a fresh per-run database identity,
# a loopback database on a non-default port, and a disposable treasury baseline.
WALLET_FUNDING_SANDBOX_MODE=false
# Optional restrictive allowlist; it never overrides host, port, reserved-name, or identity checks.
WALLET_FUNDING_DISPOSABLE_DATABASE_ALLOWLIST=
# Generate a fresh random 32-character lowercase hex identity for each local test run.
WALLET_FUNDING_SANDBOX_ID=
# WALLET_FUNDING_TREASURY_ACCOUNT_ID=
# Keep true until Club Coins policy and launch review are complete.
CLUB_COINS_HARD_DISABLED=true
CURRENCY=USD
# Daily public reference rates power display estimates only; checkout remains in CURRENCY.
FX_REFERENCE_FETCH_ENABLED=true
# Optional reference-rate source and freshness window; defaults shown.
FX_REFERENCE_API_BASE_URL=https://api.frankfurter.dev/v2
FX_REFERENCE_MAX_AGE_HOURS=72
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
# Separate Store-plan sandbox billing; keep disabled unless dedicated test-mode credentials are configured.
STORE_PLAN_BILLING_SANDBOX_ENABLED=false
STRIPE_STORE_BILLING_SECRET_KEY=
STRIPE_STORE_BILLING_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=placeholder
PAYPAL_CLIENT_SECRET=placeholder
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=placeholder
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
# Hard gate for enabling live provider configurations in the admin registry.
LIVE_PROVIDER_CONFIGURATIONS_AVAILABLE=false
# LiveKit can be self-hosted or used through LiveKit Cloud. Keep credentials server-side.
# LIVEKIT_URL=https://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LiveKit Egress MP4 recordings are opt-in. Keep the bucket private until sellers publish replays.
LIVE_RECORDING_STORAGE_AVAILABLE=false
# LIVE_RECORDING_STORAGE_BUCKET=your-private-bucket
# LIVE_RECORDING_STORAGE_REGION=your-region
# LIVE_RECORDING_STORAGE_ENDPOINT=https://s3-compatible.example.com
# LIVE_RECORDING_STORAGE_ACCESS_KEY_ID=your-dedicated-access-key
# LIVE_RECORDING_STORAGE_SECRET_ACCESS_KEY=your-dedicated-secret
LIVE_RECORDING_STORAGE_FORCE_PATH_STYLE=false
UPLOAD_DIR=uploads
# Hard deployment gate. Keep false until a managed provider is selected and configured.
LIVE_SHOPPING_AVAILABLE=false
SITE_URL=http://localhost:4000
# DNS name supplied by the hosting operator for seller custom-domain CNAME records.
# Configure the hostname in your hosting provider and enable HTTPS separately.
# CUSTOM_DOMAIN_TARGET=stores.example-host.net
CONTENT_STORAGE_DIR=storage/content
# Managed S3-compatible object storage is required for browser-direct uploads. Keep disabled until configured.
CONTENT_OBJECT_STORAGE_AVAILABLE=false
CONTENT_OBJECT_STORAGE_BUCKET=
CONTENT_OBJECT_STORAGE_REGION=
CONTENT_OBJECT_STORAGE_ENDPOINT=
# Sponsored placements and store email delivery stay disabled until integrations and policies are reviewed.
STORE_BUSTER_SPONSORED_AVAILABLE=false
STORE_EMAIL_DELIVERY_AVAILABLE=false
# SMTP settings can be managed per-provider in Admin > Store Buster & email; these variables remain
# an optional deployment fallback. Credentials saved in the dashboard are encrypted in the database.
# Store marketing additionally needs STORE_EMAIL_TOKEN_SECRET and its explicit gate. Never commit secrets.
# Marketing remains disabled until policy/consent review and STORE_EMAIL_DELIVERY_AVAILABLE=true.
# STORE_EMAIL_SMTP_HOST=smtp.example.com
# STORE_EMAIL_SMTP_PORT=587
# STORE_EMAIL_SMTP_SECURE=false
# STORE_EMAIL_SMTP_REQUIRE_TLS=true
# STORE_EMAIL_SMTP_USER=
# STORE_EMAIL_SMTP_PASSWORD=
# STORE_EMAIL_FROM=updates@example.com
# STORE_EMAIL_REPLY_TO=support@example.com
# Generate a dedicated high-entropy secret (at least 32 characters); do not reuse app secrets.
# STORE_EMAIL_TOKEN_SECRET=
# Keep true for staging/production until an antivirus scanner hook is configured.
CONTENT_SCAN_REQUIRED=true
CONTENT_SCANNER_AVAILABLE=false
CONTENT_SCANNER_HOST=
CONTENT_SCANNER_PORT=3310
CONTENT_SCANNER_TIMEOUT_MS=15000
CONTENT_MAX_IMAGE_BYTES=5000000
CONTENT_MAX_VIDEO_BYTES=50000000
CONTENT_MAX_DOCUMENT_BYTES=10000000
AFFILIATE_DEFAULT_BASIS_POINTS=500
AFFILIATE_SIGNING_SECRET=replace-with-a-long-random-server-only-secret
