model User {
  id                                  String                             @id @default(cuid())
  email                               String                             @unique
  passwordHash                        String
  name                                String
  role                                Role                               @default(BUYER)
  accountStatus                       String                             @default("ACTIVE") @db.VarChar(16)
  emailVerifiedAt                     DateTime?
  emailVerificationTokenHash          String?                            @unique
  emailVerificationExpiresAt          DateTime?
  emailVerificationSentAt             DateTime?
  onboardingCompletedAt               DateTime?
  referralSource                      ReferralSource?
  referralOther                       String?                            @db.VarChar(120)
  avatarMediaId                       String?                            @unique
  createdAt                           DateTime                           @default(now())
  updatedAt                           DateTime                           @updatedAt
  sessions                            Session[]
  socialIdentities                    SocialLoginIdentity[]
  seller                              Seller?
  auditLogs                           AuditLog[]
  posSessions                         POSSession[]
  orders                              ParentOrder[]                      @relation("BuyerOrders")
  addresses                           SavedAddress[]
  preference                          UserPreference?
  staffMemberships                    SellerStaff[]
  platformCollaborator                PlatformCollaborator?
  platformCollaboratorsCreated        PlatformCollaborator[]                 @relation("PlatformCollaboratorCreator")
  platformTeamPositionsCreated         PlatformTeamPosition[]                 @relation("PlatformTeamPositionCreator")
  cart                                Cart?
  liveReports                         LiveSessionReport[]
  reviewedLiveReports                 LiveSessionReport[]                @relation("ReviewedLiveReports")
  authoredBlogPosts                   BlogPost[]                         @relation("BlogPostAuthors")
  editedBlogPosts                     BlogPost[]                         @relation("BlogPostEditors")
  editedContentPages                  ContentPage[]
  blogRevisions                       BlogPostRevision[]
  pageRevisions                       ContentPageRevision[]
  uploadedMedia                       MediaAsset[]
  avatarMedia                         MediaAsset?                        @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  contentAuditPreviews                ContentPreviewToken[]
  slugRedirects                       SlugRedirect[]
  favorites                           Favorite[]
  affiliateProfile                    AffiliateProfile?
  wholesaleApplication                WholesaleApplication?
  notifications                       Notification[]
  notificationPreferences             NotificationPreference[]
  pushSubscriptions                   PushSubscription[]
  conversationsAsBuyer                Conversation[]                     @relation("ConversationBuyer")
  sentMessages                        Message[]
  sentMessageAttachments              MessageAttachment[]                @relation("MessageAttachmentSender")
  messageReactions                    MessageReaction[]
  aiUsageLogs                         AiUsageLog[]
  jimaConversations                   JimaConversation[]
  seofyAudits                         SeofyAudit[]
  createdCampaigns                    MarketingCampaign[]
  emailOutbox                         EmailOutbox[]
  platformBrandingRevisions           PlatformBrandingRevision[]
  onboardingExperiencesUpdated        OnboardingExperience[]           @relation("OnboardingExperienceUpdater")
  onboardingExperienceRevisions       OnboardingExperienceRevision[]
  storeThemeRevisions                 StoreThemeRevision[]
  siteChromeRevisions                 SiteChromeRevision[]                @relation("SiteChromeEditor")
  sellerAdminNotes                    SellerAdminNote[]
  sellerModerationEvents              SellerModerationEvent[]
  payoutMethodsCreated                SellerPayoutMethod[]               @relation("PayoutMethodCreator")
  payoutLedgerEntriesCreated          SellerPayoutLedgerEntry[]          @relation("PayoutLedgerCreator")
  payoutRequestsCreated               SellerPayout[]                     @relation("PayoutRequester")
  payoutReviews                       SellerPayout[]                     @relation("PayoutReviewer")
  brandingUpdates                     PlatformBranding[]                 @relation("BrandingUpdater")
  walletAccount                       WalletAccount?
  clubCoinAccount                     ClubCoinAccount?
  walletFundingIntents                WalletFundingIntent[]
  walletTransfersSent                 WalletTransfer[]                   @relation("WalletTransferSender")
  walletTransfersReceived             WalletTransfer[]                   @relation("WalletTransferRecipient")
  walletWithdrawalRequests            WalletWithdrawalRequest[]
  clubCoinEntries                     ClubCoinEntry[]
  clubCoinRedemptions                 ClubCoinRedemption[]
  storeInterestSignals                StoreInterestSignal[]
  reviewedStoreBusterCampaigns        StoreBusterCampaign[]              @relation("StoreBusterCampaignReviewer")
  storeBusterSettingsUpdates          StoreBusterSettings[]
  storeBusterFundingIntents           StoreBusterAdFundingIntent[]
  clubCoinRulesCreated                ClubCoinRule[]                     @relation("ClubCoinRuleCreator")
  storePlanVersionsCreated            StorePlanVersion[]                 @relation("StorePlanVersionCreator")
  storePlanAssignmentsMade            StorePlanAssignment[]              @relation("StorePlanAssignmentAdmin")
  storePlanSubscriptionsRequested     StoreSubscription[]                @relation("StoreSubscriptionRequester")
  providerConfigurationsCreated       ProviderConfiguration[]            @relation("ProviderConfigurationCreator")
  socialLoginConfigurationsUpdated    SocialLoginProviderConfiguration[] @relation("SocialLoginConfigurationUpdater")
  authPageCustomizationsUpdated       AuthPageCustomization[]            @relation("AuthPageCustomizationUpdater")
  providerConfigurationsUpdated       ProviderConfiguration[]            @relation("ProviderConfigurationUpdater")
  shippingCarriersCreated             ShippingCarrierProvider[]          @relation("ShippingCarrierCreator")
  shippingCarriersUpdated             ShippingCarrierProvider[]          @relation("ShippingCarrierUpdater")
  manualExchangeRatesCreated          ManualExchangeRateVersion[]        @relation("ManualExchangeRateCreator")
  sellerCommissionPoliciesCreated     SellerCommissionPolicyVersion[]    @relation("SellerCommissionPolicyCreator")
  sellerCommissionReviewsCreated      SellerCommissionReviewEvent[]      @relation("SellerCommissionReviewCreator")
  catalogSuggestionsSubmitted         CatalogSuggestion[]                @relation("CatalogSuggestionSubmitter")
  catalogSuggestionsReviewed          CatalogSuggestion[]                @relation("CatalogSuggestionReviewer")
  shipmentUpdatesCreated              ShipmentUpdate[]                   @relation("ShipmentUpdateCreator")
  buyerReceiptConfirmations           SellerOrder[]                      @relation("BuyerReceiptConfirmation")
  orderResolutionCasesOpened          OrderResolutionCase[]              @relation("OrderResolutionBuyer")
  orderResolutionCasesDecided         OrderResolutionCase[]              @relation("OrderResolutionDecider")
  orderResolutionMessages             OrderResolutionMessage[]
  supportTicketsOpened                SupportTicket[]                    @relation("SupportTicketBuyer")
  supportTicketsAssigned              SupportTicket[]                    @relation("SupportTicketAssignee")
  supportMessages                     SupportMessage[]
  productReviews                      ProductReview[]                    @relation("ProductReviewAuthor")
  moderatedProductReviews             ProductReview[]                    @relation("ProductReviewModerator")
  liveAttendances                     LiveSessionAttendance[]
  liveSessionReactions                LiveSessionReaction[]
  liveSessionReposts                  LiveSessionRepost[]
  storeFollows                        StoreFollow[]
  marketplaceProductAds               MarketplaceProductAd[]             @relation("MarketplaceProductAdOwner")
  reviewedMarketplaceProductAds       MarketplaceProductAd[]             @relation("MarketplaceProductAdReviewer")
  directAdConversations               Conversation[]                     @relation("ConversationDirectRecipient")
  marketplaceProductAdSettingsUpdates MarketplaceProductAdSettings[]

  @@index([role, accountStatus, createdAt])
}

model PlatformCollaborator {
  id          String   @id @default(cuid())
  userId      String   @unique
  position    String   @db.VarChar(32)
  permissions String[] @default([])
  enabled     Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("PlatformCollaboratorCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([enabled, position])
}

model PlatformTeamPosition {
  id             String   @id @db.VarChar(32)
  name           String   @db.VarChar(48)
  nameNormalized String   @unique @db.VarChar(96)
  permissions    String[] @default([])
  enabled        Boolean  @default(true)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      User     @relation("PlatformTeamPositionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([enabled, name])
}

model SavedAddress {
  id         String   @id @default(cuid())
  userId     String
  label      String
  line1      String
  line2      String?
  city       String
  region     String
  postalCode String
  country    String
  latitude   Float?
  longitude  Float?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault, updatedAt])
}

model UserPreference {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  language                 String    @default("en")
  displayCurrency          String    @default("USD")
  personalizationEnabled   Boolean   @default(false)
  personalizationConsentAt DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CurrencyCatalogEntry {
  code                       String                          @id @db.VarChar(3)
  numericCode                String?                         @db.VarChar(3)
  name                       String                          @db.VarChar(100)
  symbol                     String                          @db.VarChar(16)
  minorUnitExponent          Int
  region                     String                          @db.VarChar(32)
  active                     Boolean                         @default(true)
  displayEnabled             Boolean                         @default(false)
  storePricingEnabled        Boolean                         @default(false)
  checkoutEnabled            Boolean                         @default(false)
  subscriptionEnabled        Boolean                         @default(false)
  settlementEnabled          Boolean                         @default(false)
  reportingEnabled           Boolean                         @default(true)
  createdAt                  DateTime                        @default(now())
  updatedAt                  DateTime                        @updatedAt
  baseStores                 Store[]                         @relation("StoreBaseCurrency")
  storeOffers                StoreCurrencyOffer[]
  baseRates                  ExchangeRateSnapshot[]          @relation("FxBaseCurrency")
  quoteRates                 ExchangeRateSnapshot[]          @relation("FxQuoteCurrency")
  manualBaseRates            ManualExchangeRateVersion[]     @relation("ManualFxBaseCurrency")
  manualQuoteRates           ManualExchangeRateVersion[]     @relation("ManualFxQuoteCurrency")
  commissionReportingEntries SellerCommissionLedgerEntry[]   @relation("CommissionReportingCurrency")
  sellerCommissionPolicies   SellerCommissionPolicyVersion[] @relation("SellerCommissionPolicyCurrency")
  orderItemCurrencies        OrderItem[]                     @relation("OrderItemCurrencySnapshot")
  orderItemDisplayCurrencies OrderItem[]                     @relation("OrderItemDisplayCurrency")

  @@index([active, displayEnabled, region])
}

model StoreCurrencyOffer {
  id              String               @id @default(cuid())
  storeId         String
  currency        String               @db.VarChar(3)
  displayEnabled  Boolean              @default(true)
  checkoutEnabled Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  store           Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  currencyEntry   CurrencyCatalogEntry @relation(fields: [currency], references: [code], onDelete: Restrict)

  @@unique([storeId, currency])
  @@index([currency, displayEnabled])
}

model ExchangeRateSnapshot {
  id            String               @id @default(cuid())
  baseCurrency  String               @db.VarChar(3)
  quoteCurrency String               @db.VarChar(3)
  rate          Decimal              @db.Decimal(30, 12)
  provider      String               @db.VarChar(40)
  sourceDate    DateTime             @db.Date
  fetchedAt     DateTime             @default(now())
  baseEntry     CurrencyCatalogEntry @relation("FxBaseCurrency", fields: [baseCurrency], references: [code], onDelete: Restrict)
  quoteEntry    CurrencyCatalogEntry @relation("FxQuoteCurrency", fields: [quoteCurrency], references: [code], onDelete: Restrict)

  @@unique([baseCurrency, quoteCurrency, provider, sourceDate])
  @@index([baseCurrency, quoteCurrency, fetchedAt])
}

model ManualExchangeRateVersion {
  id             String               @id @default(cuid())
  storeId        String?
  version        Int
  baseCurrency   String               @db.VarChar(3)
  quoteCurrency  String               @db.VarChar(3)
  rate           Decimal              @db.Decimal(30, 12)
  effectiveFrom  DateTime
  effectiveUntil DateTime?
  reason         String               @db.VarChar(500)
  createdById    String
  createdAt      DateTime             @default(now())
  store          Store?               @relation(fields: [storeId], references: [id], onDelete: Restrict)
  baseEntry      CurrencyCatalogEntry @relation("ManualFxBaseCurrency", fields: [baseCurrency], references: [code], onDelete: Restrict)
  quoteEntry     CurrencyCatalogEntry @relation("ManualFxQuoteCurrency", fields: [quoteCurrency], references: [code], onDelete: Restrict)
  createdBy      User                 @relation("ManualExchangeRateCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([storeId, baseCurrency, quoteCurrency, version])
  @@index([storeId, baseCurrency, quoteCurrency, effectiveFrom, effectiveUntil])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model SocialLoginProviderConfiguration {
  id                     String              @id @default(cuid())
  provider               SocialLoginProvider @unique
  enabled                Boolean             @default(false)
  clientId               String?
  clientSecretCiphertext String?
  issuerUrl              String?
  logoUrl                String?
  updatedById            String
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  updatedBy              User                @relation("SocialLoginConfigurationUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
}

model SocialLoginIdentity {
  id        String              @id @default(cuid())
  provider  SocialLoginProvider
  subject   String
  userId    String
  email     String?
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId, createdAt])
}

model OAuthLoginAttempt {
  id           String              @id @default(cuid())
  provider     SocialLoginProvider
  stateHash    String              @unique
  codeVerifier String
  nonce        String?
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime            @default(now())

  @@index([expiresAt, consumedAt])
}

model AuthPageCustomization {
  id            String         @id @default("default")
  signInHeading String         @default("Sign in") @db.VarChar(100)
  signInText    String         @default("Welcome back. Sign in to continue.") @db.VarChar(240)
  signUpHeading String         @default("Create account") @db.VarChar(100)
  signUpText    String         @default("Join the marketplace and discover independent stores.") @db.VarChar(240)
  logoMediaId   String?        @unique
  layout        AuthPageLayout @default(CENTERED)
  motion        AuthPageMotion @default(FADE)
  accentColor   String         @default("#315d47") @db.VarChar(7)
  updatedById   String?
  updatedAt     DateTime       @updatedAt
  updatedBy     User?          @relation("AuthPageCustomizationUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  logoMedia     MediaAsset?    @relation("AuthPageLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
}

model Seller {
  id                            String                        @id @default(cuid())
  userId                        String                        @unique
  status                        SellerStatus                  @default(PENDING)
  reason                        String?
  createdAt                     DateTime                      @default(now())
  updatedAt                     DateTime                      @updatedAt
  user                          User                          @relation(fields: [userId], references: [id], onDelete: Restrict)
  store                         Store?
  products                      Product[]
  staff                         SellerStaff[]
  orders                        SellerOrder[]
  posSessions                   POSSession[]
  liveSessions                  LiveSession[]
  affiliateLinks                AffiliateLink[]
  conversations                 Conversation[]                @relation("ConversationSeller")
  adminNotes                    SellerAdminNote[]
  moderationEvents              SellerModerationEvent[]
  payoutMethods                 SellerPayoutMethod[]
  payoutLedgerEntries           SellerPayoutLedgerEntry[]
  payouts                       SellerPayout[]
  shippingServices              SellerShippingService[]
  productDiscounts              SellerProductDiscount[]
  sellerCommissionLedgerEntries SellerCommissionLedgerEntry[]
  orderResolutionCases          OrderResolutionCase[]
  supportTickets                SupportTicket[]
}

model Store {
  id                         String                           @id @default(cuid())
  sellerId                   String                           @unique
  isPlatformStore            Boolean                          @default(false)
  name                       String
  description                String?
  seoTitle                   String?                          @db.VarChar(160)
  seoDescription             String?                          @db.VarChar(320)
  seofyLearningEnabled       Boolean                          @default(false)
  slug                       String                           @unique @default(cuid())
  baseCurrency               String                           @default("USD") @db.VarChar(3)
  logoMediaId                String?
  bannerMediaId              String?
  contactJson                Json?
  policyLinksJson            Json?
  themeDraftJson             Json?
  themePublishedJson         Json?
  themePublishedAt           DateTime?
  seller                     Seller                           @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  baseCurrencyEntry          CurrencyCatalogEntry             @relation("StoreBaseCurrency", fields: [baseCurrency], references: [code], onDelete: Restrict)
  logoMedia                  MediaAsset?                      @relation("StoreLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  bannerMedia                MediaAsset?                      @relation("StoreBanner", fields: [bannerMediaId], references: [id], onDelete: SetNull)
  themeRevisions             StoreThemeRevision[]
  siteChromeConfiguration   SiteChromeConfiguration?
  planAssignments            StorePlanAssignment[]
  subscriptions              StoreSubscription[]
  blogPosts                  BlogPost[]
  contentPages               ContentPage[]
  mediaAssets                MediaAsset[]
  storeBusterCampaigns       StoreBusterCampaign[]
  storeBusterAdAccount       StoreBusterAdAccount?
  emailSubscribers           StoreEmailSubscriber[]
  emailCampaigns             StoreEmailCampaign[]
  affiliateProgram           StoreAffiliateProgram?
  seofyAudits                SeofyAudit[]
  currencyOffers             StoreCurrencyOffer[]
  manualExchangeRates        ManualExchangeRateVersion[]
  sellerCommissionPolicies   SellerCommissionPolicyVersion[]
  customDomain               StoreCustomDomain?
  emailProviderConfiguration StoreEmailProviderConfiguration?
  dropshippingConnections    StoreDropshippingConnection[]
  supplierProductImports     SupplierProductImport[]
  follows                    StoreFollow[]
  marketplaceProductAds      MarketplaceProductAd[]
}

model StoreCustomDomain {
  id                    String    @id @default(cuid())
  storeId               String    @unique
  domain                String    @unique @db.VarChar(253)
  verificationTokenHash String    @db.VarChar(64)
  cnameTarget           String    @db.VarChar(253)
  status                String    @default("PENDING_DNS") @db.VarChar(24)
  verifiedAt            DateTime?
  lastCheckedAt         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  store                 Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([status, lastCheckedAt])
}

model StoreEmailProviderConfiguration {
  storeId            String    @id
  provider           String    @db.VarChar(32)
  host               String    @db.VarChar(255)
  port               Int
  secure             Boolean   @default(false)
  requireTls         Boolean   @default(true)
  username           String?   @db.VarChar(255)
  passwordCiphertext String?   @db.Text
  senderName         String    @db.VarChar(120)
  senderEmail        String    @db.VarChar(320)
  replyTo            String?   @db.VarChar(320)
  active             Boolean   @default(false)
  verifiedAt         DateTime?
  lastTestAt         DateTime?
  lastTestCode       String?   @db.VarChar(40)
  updatedById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  store              Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([provider, active])
}

model StoreFollow {
  userId    String
  storeId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
  @@index([storeId, createdAt])
}

model StoreDropshippingConnection {
  id                   String    @id @default(cuid())
  storeId              String
  provider             String
  encryptedCredentials String    @db.Text
  status               String    @default("CONNECTED")
  connectedAt          DateTime  @default(now())
  lastCheckedAt        DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  store                Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, provider])
  @@index([provider, status])
}

model SupplierProductImport {
  id                   String   @id @default(cuid())
  storeId              String
  productId            String   @unique
  provider             String
  externalProductId    String
  externalSku          String?
  supplierCostUsdMinor Int?
  sourceUrl            String?
  importedAt           DateTime @default(now())
  store                Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product              Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([storeId, provider, externalProductId])
  @@index([storeId, importedAt])
}

model SellerStaff {
  id                     String  @id @default(cuid())
  sellerId               String
  userId                 String
  canPos                 Boolean @default(true)
  canManageStoreBranding Boolean @default(false)
  canManageCurrency      Boolean @default(false)
  canManageShipping      Boolean @default(false)
  seller                 Seller  @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  user                   User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([sellerId, userId])
}

model Category {
  id                       String                          @id @default(cuid())
  name                     String                          @unique
  slug                     String                          @unique
  description              String?
  imageUrl                 String?
  status                   TaxonomyStatus                  @default(ACTIVE)
  displayOrder             Int                             @default(0)
  parentId                 String?
  parent                   Category?                       @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children                 Category[]                      @relation("CategoryTree")
  catalogFeatures          CatalogFeature[]                @relation("FeatureCategory")
  childCategorySuggestions CatalogSuggestion[]             @relation("SuggestedParentCategory")
  featureSuggestions       CatalogSuggestion[]             @relation("SuggestedFeatureCategory")
  products                 Product[]
  affiliateCommissionRules AffiliateCommissionRule[]
  interestSignals          StoreInterestSignal[]
  productDiscountTargets   SellerProductDiscountCategory[]

  @@index([parentId, status, displayOrder])
}

model Brand {
  id           String         @id @default(cuid())
  name         String         @unique
  slug         String         @unique
  description  String?
  imageUrl     String?
  status       TaxonomyStatus @default(ACTIVE)
  displayOrder Int            @default(0)
  products     Product[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status, displayOrder])
}

model CatalogProductType {
  id               String           @id @default(cuid())
  name             String           @unique
  slug             String           @unique
  description      String?
  requiresShipping Boolean          @default(true)
  status           TaxonomyStatus   @default(ACTIVE)
  displayOrder     Int              @default(0)
  products         Product[]
  features         CatalogFeature[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, displayOrder])
}

model CatalogDefaultSuppression {
  id         String   @id @default(cuid())
  defaultKey String   @unique
  entityKind String
  removedAt  DateTime @default(now())
}

model CatalogFeature {
  id            String                     @id @default(cuid())
  name          String
  slug          String                     @unique
  categoryId    String?
  productTypeId String?
  status        TaxonomyStatus             @default(ACTIVE)
  displayOrder  Int                        @default(0)
  category      Category?                  @relation("FeatureCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  productType   CatalogProductType?        @relation(fields: [productTypeId], references: [id], onDelete: SetNull)
  products      ProductFeatureAssignment[]
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@index([categoryId, status, displayOrder])
  @@index([productTypeId, status, displayOrder])
}

model CatalogSuggestion {
  id               String                  @id @default(cuid())
  kind             CatalogSuggestionKind
  name             String
  normalizedName   String
  parentCategoryId String?
  categoryId       String?
  status           CatalogSuggestionStatus @default(PENDING)
  submittedById    String
  reviewedById     String?
  reviewNote       String?
  reviewedAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  parentCategory   Category?               @relation("SuggestedParentCategory", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  featureCategory  Category?               @relation("SuggestedFeatureCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  submittedBy      User                    @relation("CatalogSuggestionSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy       User?                   @relation("CatalogSuggestionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([kind, normalizedName])
}

model ProductFeatureAssignment {
  productId String
  featureId String
  createdAt DateTime       @default(now())
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  feature   CatalogFeature @relation(fields: [featureId], references: [id], onDelete: Restrict)

  @@id([productId, featureId])
  @@index([featureId])
}

model Product {
  id                       String                          @id @default(cuid())
  sellerId                 String?
  categoryId               String?
  brandId                  String?
  productTypeId            String
  name                     String
  slug                     String                          @unique
  description              String
  seoTitle                 String?                         @db.VarChar(160)
  seoDescription           String?                         @db.VarChar(320)
  color                    String?
  priceMinor               Int
  salePriceMinor           Int?
  currency                 String                          @default("USD")
  status                   ProductStatus                   @default(PENDING)
  barcode                  String?
  wholesaleEnabled         Boolean                         @default(false)
  wholesaleMinQuantity     Int?
  wholesaleMaxQuantity     Int?
  wholesalePackSize        Int?
  createdAt                DateTime                        @default(now())
  updatedAt                DateTime                        @updatedAt
  seller                   Seller?                         @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category                 Category?                       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand                    Brand?                          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  productType              CatalogProductType              @relation(fields: [productTypeId], references: [id], onDelete: Restrict)
  featureAssignments       ProductFeatureAssignment[]
  images                   ProductImage[]
  mediaAttachments         ProductMedia[]
  inventory                Inventory?
  cartItems                CartItem[]
  orderItems               OrderItem[]
  liveSessionProducts      LiveSessionProduct[]
  variants                 ProductVariant[]
  favorites                Favorite[]
  wholesaleTiers           WholesaleTierPrice[]
  affiliateLinks           AffiliateLink[]
  affiliateClicks          AffiliateClick[]
  affiliateCommissionRules AffiliateCommissionRule[]
  interestSignals          StoreInterestSignal[]
  storeBusterCampaigns     StoreBusterCampaignProduct[]
  storeBusterImpressions   StoreBusterImpression[]
  campaignProducts         MarketingCampaignProduct[]
  conversationProducts     Conversation[]
  shippingDiscountProducts SellerShippingDiscountProduct[]
  productDiscountTargets   SellerProductDiscountProduct[]  @relation("DiscountSelectedProducts")
  supplierImport           SupplierProductImport?
  reviews                  ProductReview[]
  marketplaceProductAds    MarketplaceProductAd[]

  @@index([status, categoryId])
  @@index([sellerId, status])
  @@index([brandId, status])
  @@index([productTypeId, status])
  @@index([barcode])
}

model ProductImage {
  id           String      @id @default(cuid())
  productId    String
  mediaAssetId String?
  url          String
  alt          String
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([mediaAssetId])
}

model ProductMedia {
  id           String     @id @default(cuid())
  productId    String
  mediaAssetId String
  position     Int        @default(0)
  label        String?
  createdAt    DateTime   @default(now())
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([productId, mediaAssetId])
  @@index([productId, position])
  @@index([mediaAssetId])
}

model Inventory {
  id        String  @id @default(cuid())
  productId String  @unique
  quantity  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model ProductVariant {
  id             String               @id @default(cuid())
  productId      String
  name           String
  sku            String               @unique
  priceMinor     Int
  currency       String               @default("USD")
  stock          Int                  @default(0)
  status         ProductStatus        @default(APPROVED)
  imageUrl       String?
  mediaAssetId   String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  product        Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  cartItems      CartItem[]
  orderItems     OrderItem[]
  wholesaleTiers WholesaleTierPrice[]
  mediaAsset     MediaAsset?           @relation("ProductVariantImage", fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@index([productId, status])
  @@index([mediaAssetId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  variantId String?
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId, variantId])
  @@index([variantId])
}

model ParentOrder {
  id                     String                        @id @default(cuid())
  orderNumber            String                        @unique
  buyerId                String?
  buyerEmail             String
  buyerName              String
  addressJson            Json
  totalMinor             Int
  currency               String
  status                 OrderStatus                   @default(PENDING)
  createdAt              DateTime                      @default(now())
  affiliateClickId       String?                       @unique
  buyer                  User?                         @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: SetNull)
  sellerOrders           SellerOrder[]
  conversations          Conversation[]
  payment                Payment?
  affiliateClick         AffiliateClick?               @relation("AffiliateConversion", fields: [affiliateClickId], references: [id], onDelete: SetNull)
  affiliateAdjustments   AffiliateAdjustment[]
  commissionReviewEvents SellerCommissionReviewEvent[]
  processedWebhookEvents ProcessedWebhookEvent[]
  orderResolutionCases   OrderResolutionCase[]
  supportTickets         SupportTicket[]

  @@index([buyerId, createdAt])
}

model SellerOrder {
  id                        String                         @id @default(cuid())
  parentId                  String
  sellerId                  String?
  status                    OrderStatus                    @default(PENDING)
  totalMinor                Int
  discountCode              String?
  discountMinor             Int                            @default(0)
  shippingSnapshotJson      Json?
  shipmentStatus            ShipmentStatus?
  shippingCarrier           String?                        @db.VarChar(120)
  trackingNumber            String?                        @db.VarChar(160)
  trackingUrl               String?                        @db.VarChar(2000)
  shippedAt                 DateTime?
  deliveredAt               DateTime?
  receivedAt                DateTime?
  receiptConfirmedById      String?
  commissionSnapshotJson    Json?
  commissionPolicyVersionId String?
  parent                    ParentOrder                    @relation(fields: [parentId], references: [id], onDelete: Restrict)
  seller                    Seller?                        @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  commissionPolicyVersion   SellerCommissionPolicyVersion? @relation(fields: [commissionPolicyVersionId], references: [id], onDelete: Restrict)
  items                     OrderItem[]
  shipmentUpdates           ShipmentUpdate[]
  receiptConfirmedBy        User?                          @relation("BuyerReceiptConfirmation", fields: [receiptConfirmedById], references: [id], onDelete: SetNull)
  payoutLedgerEntries       SellerPayoutLedgerEntry[]
  sellerCommissionEntries   SellerCommissionLedgerEntry[]
  resolutionCase            OrderResolutionCase?
  supportTickets            SupportTicket[]
  productReviews            ProductReview[]

  @@index([sellerId, status])
  @@index([shipmentStatus, shippedAt])
  @@index([receivedAt])
}

model ShipmentUpdate {
  id             String         @id @default(cuid())
  sellerOrderId  String
  status         ShipmentStatus
  carrier        String?        @db.VarChar(120)
  trackingNumber String?        @db.VarChar(160)
  trackingUrl    String?        @db.VarChar(2000)
  note           String?        @db.VarChar(500)
  createdById    String
  createdAt      DateTime       @default(now())
  sellerOrder    SellerOrder    @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  createdBy      User           @relation("ShipmentUpdateCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([sellerOrderId, createdAt])
}

model OrderResolutionCase {
  id                        String                   @id
  parentOrderId             String
  sellerOrderId             String                   @unique
  buyerId                   String
  sellerId                  String?
  type                      String                   @db.VarChar(32)
  status                    String                   @default("OPEN") @db.VarChar(32)
  reason                    String                   @db.VarChar(80)
  description               String                   @db.VarChar(3000)
  requestedAmountMinor      Int?
  approvedAmountMinor       Int?
  resolutionNote            String?                  @db.VarChar(1500)
  providerWebhookEventRowId String?
  manualRefundReference     String?                  @db.VarChar(200)
  decidedById               String?
  settledAt                 DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  parentOrder               ParentOrder              @relation(fields: [parentOrderId], references: [id], onDelete: Restrict)
  sellerOrder               SellerOrder              @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  buyer                     User                     @relation("OrderResolutionBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller                    Seller?                  @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  decidedBy                 User?                    @relation("OrderResolutionDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  providerWebhookEvent      ProcessedWebhookEvent?   @relation(fields: [providerWebhookEventRowId], references: [id], onDelete: Restrict)
  messages                  OrderResolutionMessage[]

  @@index([status, updatedAt])
  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([parentOrderId, status])
}

model OrderResolutionMessage {
  id             String              @id
  caseId         String
  authorId       String
  authorRole     String              @db.VarChar(24)
  body           String              @db.VarChar(3000)
  createdAt      DateTime            @default(now())
  resolutionCase OrderResolutionCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  author         User                @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
}

model OrderItem {
  id                      String                        @id @default(cuid())
  sellerOrderId           String
  productId               String
  productName             String
  unitPriceMinor          Int
  quantity                Int
  discountMinor           Int                           @default(0)
  currencySnapshot        String?                       @db.VarChar(3)
  displayAmountMinor      Int?
  displayCurrency         String?                       @db.VarChar(3)
  fxSnapshotJson          Json?
  variantId               String?
  variantName             String?
  sellerOrder             SellerOrder                   @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  product                 Product                       @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant                 ProductVariant?               @relation(fields: [variantId], references: [id], onDelete: Restrict)
  affiliateCommissions    CommissionLedger[]
  affiliateAdjustments    AffiliateAdjustment[]
  payoutLedgerEntries     SellerPayoutLedgerEntry[]
  sellerCommissionEntries SellerCommissionLedgerEntry[]
  currencySnapshotEntry   CurrencyCatalogEntry?         @relation("OrderItemCurrencySnapshot", fields: [currencySnapshot], references: [code], onDelete: Restrict)
  displayCurrencyEntry    CurrencyCatalogEntry?         @relation("OrderItemDisplayCurrency", fields: [displayCurrency], references: [code], onDelete: Restrict)

  @@index([variantId])
}

model Payment {
  id          String           @id @default(cuid())
  parentId    String           @unique
  method      PaymentMethod
  status      PaymentStatus    @default(PENDING)
  providerRef String?
  paidAt      DateTime?
  parent      ParentOrder      @relation(fields: [parentId], references: [id], onDelete: Restrict)
  attempts    PaymentAttempt[]

  @@index([method, status])
}

model PaymentAttempt {
  id             String        @id @default(cuid())
  paymentId      String
  provider       PaymentMethod
  providerRef    String?
  idempotencyKey String?
  status         PaymentStatus
  metadata       Json?
  createdAt      DateTime      @default(now())
  payment        Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerRef])
  @@index([idempotencyKey])
}

model ProcessedWebhookEvent {
  id                    String                @id @default(cuid())
  provider              PaymentMethod
  eventId               String
  receivedAt            DateTime              @default(now())
  providerOccurredAt    DateTime?
  eventType             String?
  reviewReason          String?
  parentOrderId         String?
  amountMinor           Int?
  currency              String?               @db.VarChar(3)
  normalizedAmountMinor Int?
  normalizedCurrency    String?               @db.VarChar(3)
  providerObjectRef     String?
  paymentLookupRef      String?
  captureConfirmed      Boolean?
  metadataOrderId       String?
  providerTotalMinor    Int?
  identityVerified      Boolean               @default(true)
  parentOrder           ParentOrder?          @relation(fields: [parentOrderId], references: [id], onDelete: Restrict)
  orderResolutionCases  OrderResolutionCase[]

  @@unique([provider, eventId])
  @@index([provider, reviewReason])
  @@index([parentOrderId, provider, receivedAt])
  @@index([provider, providerObjectRef, reviewReason])
}

model MarketplaceSettings {
  id                             String                   @id @default("default")
  jimaConfig                     Json?
  enabledLanguages               String[]                 @default(["en", "fil"])
  multiVendorEnabled             Boolean                  @default(true)
  sellerShippingEnabled          Boolean                  @default(true)
  liveShoppingEnabled            Boolean                  @default(false)
  affiliateEnabled               Boolean                  @default(false)
  affiliateFundingConfigured     Boolean                  @default(false)
  affiliateAttributionRule       AffiliateAttributionRule @default(LAST_VALID_CLICK)
  affiliateAttributionWindowDays Int                      @default(30)
  affiliateMinimumPayoutMinor    Int                      @default(0)
  codMaxMinor                    Int?
  sellerApprovalPolicy           ApprovalPolicy           @default(MANUAL)
  productApprovalPolicy          ApprovalPolicy           @default(MANUAL)
  sellerPayoutsEnabled           Boolean                  @default(false)
  payoutFundingConfigured        Boolean                  @default(false)
  manualBankPayoutsEnabled       Boolean                  @default(false)
  manualEwalletPayoutsEnabled    Boolean                  @default(false)
  stripeConnectPayoutsEnabled    Boolean                  @default(false)
  paypalPayoutsEnabled           Boolean                  @default(false)
  payoutHoldDays                 Int                      @default(7)
  payoutMinimumMinor             Int                      @default(0)
  walletEnabled                  Boolean                  @default(false)
  walletFundingEnabled           Boolean                  @default(false)
  walletTransfersEnabled         Boolean                  @default(false)
  walletCheckoutEnabled          Boolean                  @default(false)
  walletWithdrawalsEnabled       Boolean                  @default(false)
  walletEmergencyPause           Boolean                  @default(true)
  clubCoinsEnabled               Boolean                  @default(false)
  clubCoinsEarnEnabled           Boolean                  @default(false)
  clubCoinsRedeemEnabled         Boolean                  @default(false)
  clubCoinTransfersEnabled       Boolean                  @default(false)
  clubCoinConversionEnabled      Boolean                  @default(false)
  clubCoinRedemptionRatio        Int                      @default(100)
  clubCoinMaxDiscountMinor       Int                      @default(0)
  clubCoinName                   String                   @default("Club Coins")
  clubCoinIconUrl                String?
  themeCatalogJson               Json?
