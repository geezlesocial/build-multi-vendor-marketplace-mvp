  editor         User             @relation(fields: [editorId], references: [id], onDelete: Restrict)
  store          Store?            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  ogImage        MediaAsset?      @relation("PageOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  revisions      ContentPageRevision[]
  previewTokens  ContentPreviewToken[]
  @@index([status, publishedAt])
  @@index([parentId, navPlacement, navOrder])
  @@index([storeId, status, updatedAt])
}

model ContentPageRevision {
  id             String      @id @default(cuid())
  pageId         String
  revisionNumber Int
  slug           String
  title          String
  bodyJson       Json
  metadataJson   Json?
  editorId       String
  changeNote     String?
  createdAt      DateTime    @default(now())
  page           ContentPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  editor         User        @relation(fields: [editorId], references: [id], onDelete: Restrict)
  @@unique([pageId, revisionNumber])
  @@index([pageId, createdAt])
}

model MediaAsset {
  id            String          @id @default(cuid())
  storageKey    String          @unique
  originalName  String
  safeName      String
  kind          MediaKind
  detectedMime  String
  sizeBytes     Int
  width         Int?
  height        Int?
  durationMs    Int?
  checksum      String
  uploaderId    String
  storeId       String?
  purpose       MediaPurpose     @default(GENERAL)
  uploadStatus  MediaUploadStatus @default(COMPLETE)
  storageProvider MediaStorageProvider @default(LOCAL)
  altText       String?
  caption       String?
  scanStatus    MediaScanStatus @default(QUARANTINED)
  scanAttemptCount Int            @default(0)
  scanAttemptId String?           @unique
  scanStartedAt DateTime?
  scanCompletedAt DateTime?
  scanErrorCode String?           @db.VarChar(64)
  scannerProvider String?         @db.VarChar(32)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  uploader      User            @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  store         Store?          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  avatarUsers   User[]          @relation("UserAvatar")
  featuredPosts BlogPost[]      @relation("BlogFeaturedImage")
  blogOgPosts   BlogPost[]      @relation("BlogOgImage")
  pageOgPages   ContentPage[]   @relation("PageOgImage")
  storeLogos    Store[]         @relation("StoreLogo")
  storeBanners  Store[]         @relation("StoreBanner")
  productImages ProductImage[]
  @@index([scanStatus, kind, createdAt])
  @@index([storeId, uploadStatus, createdAt])
}

model StoreInterestSignal {
  id         String                  @id @default(cuid())
  userId     String
  productId  String?
  categoryId String?
  type       StoreInterestSignalType
  createdAt  DateTime                @default(now())
  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product?                @relation(fields: [productId], references: [id], onDelete: SetNull)
  category   Category?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@index([userId, categoryId, createdAt])
  @@index([userId, productId, createdAt])
}

model StoreBusterSettings {
  id                     String   @id @default("default")
  enabled                Boolean  @default(false)
  sponsoredEnabled       Boolean  @default(false)
  moderationRequired     Boolean  @default(true)
  maxMonthlyBudgetMinor  Int      @default(0)
  maxCampaignsPerStore   Int      @default(0)
  pricePerClickMinor     Int      @default(0)
  updatedById            String?
  updatedAt              DateTime @updatedAt
  updatedBy              User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

model StoreBusterCampaign {
  id                    String                    @id @default(cuid())
  storeId               String
  name                  String
  goal                  StoreBusterCampaignGoal
  status                StoreBusterCampaignStatus @default(DRAFT)
  sponsored             Boolean                   @default(false)
  monthlyBudgetMinor    Int                       @default(0)
  audienceCategoryIds   String[]                  @default([])
  moderationReason      String?
  reviewedById          String?
  reviewedAt            DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  store                 Store                     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  reviewer              User?                     @relation("StoreBusterCampaignReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  products              StoreBusterCampaignProduct[]
  metrics               StoreBusterDailyMetric[]
  impressions           StoreBusterImpression[]
  @@index([storeId, status, updatedAt])
  @@index([status, sponsored, updatedAt])
}

model StoreBusterCampaignProduct {
  campaignId String
  productId  String
  campaign   StoreBusterCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product    Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@id([campaignId, productId])
  @@index([productId])
}

model StoreBusterDailyMetric {
  id          String   @id @default(cuid())
  campaignId  String
  day         DateTime @db.Date
  impressions Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
  campaign    StoreBusterCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  @@unique([campaignId, day])
  @@index([day])
}

model StoreBusterImpression {
  id         String   @id @default(cuid())
  campaignId String
  tokenHash  String   @unique
  day        DateTime @db.Date
  expiresAt  DateTime
  clickedAt  DateTime?
  createdAt  DateTime @default(now())
  campaign   StoreBusterCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  @@index([campaignId, day])
  @@index([expiresAt])
}

model StoreAffiliateProgram {
  id        String   @id @default(cuid())
  storeId   String   @unique
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)
}

model StoreEmailSubscriber {
  id                       String                     @id @default(cuid())
  storeId                  String
  email                    String
  status                   StoreEmailSubscriberStatus @default(PENDING_CONFIRMATION)
  consentRecordedAt        DateTime?
  consentSource            String?
  confirmationTokenHash    String?                    @unique
  unsubscribeTokenHash     String                     @unique
  suppressedAt             DateTime?
  suppressionReason        String?
  bouncedAt                DateTime?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  store                    Store                      @relation(fields: [storeId], references: [id], onDelete: Restrict)
  @@unique([storeId, email])
  @@index([storeId, status, createdAt])
}

model StoreEmailCampaign {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  subject     String
  contentJson Json
  status      StoreEmailCampaignStatus @default(DRAFT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  @@index([storeId, status, updatedAt])
}

model SlugRedirect {
  id             String   @id @default(cuid())
  fromPath       String   @unique
  destinationPath String
  statusCode     Int      @default(301)
  createdById    String
  createdAt      DateTime @default(now())
  createdBy      User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  @@index([destinationPath])
}

model ContentPreviewToken {
  id         String      @id @default(cuid())
  tokenHash  String      @unique
  postId     String?
  pageId     String?
  createdById String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime    @default(now())
  post       BlogPost?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  page       ContentPage? @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdBy  User        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  @@index([expiresAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@unique([userId, productId])
  @@index([productId, createdAt])
}

model WholesaleApplication {
  id        String         @id @default(cuid())
  userId    String         @unique
  status    WholesaleStatus @default(PENDING)
  note      String?
  reviewedById String?
  reviewedAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([status, createdAt])
}

model WholesaleTierPrice {
  id          String   @id @default(cuid())
  productId   String
  variantId   String?
  minQuantity Int
  unitPriceMinor Int
  currency    String   @default("USD")
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  @@unique([productId, variantId, minQuantity])
  @@index([productId, minQuantity])
}

model AffiliateProfile {
  id                  String          @id @default(cuid())
  userId              String          @unique
  status              AffiliateStatus @default(PENDING)
  referralCode        String          @unique
  termsAcceptedAt     DateTime?
  attributionWindowDays Int            @default(30)
  reviewNote          String?
  reviewedById        String?
  reviewedAt          DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  user                User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  links               AffiliateLink[]
  clicks              AffiliateClick[]
  commissions         CommissionLedger[]
  payouts             AffiliatePayout[]
  @@index([status, createdAt])
}

model AffiliateLink {
  id          String   @id @default(cuid())
  affiliateId String
  productId   String?
  sellerId    String?
  targetPath  String
  code        String   @unique
  createdAt   DateTime @default(now())
  affiliate   AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  seller      Seller?  @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  clicks      AffiliateClick[]
  @@index([affiliateId, createdAt])
}

model AffiliateClick {
  id            String   @id @default(cuid())
  affiliateId   String
  linkId        String
  productId     String?
  tokenHash     String   @unique
  ipHash        String?
  clickedAt     DateTime @default(now())
  expiresAt     DateTime
  convertedAt   DateTime?
  consentGivenAt DateTime?
  visitorKeyHash String?
  affiliate     AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  link          AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Restrict)
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  order         ParentOrder? @relation("AffiliateConversion")
  @@index([affiliateId, clickedAt])
  @@index([expiresAt, convertedAt])
  @@index([affiliateId, visitorKeyHash, clickedAt])
}

model AffiliateCommissionRule {
  id          String   @id @default(cuid())
  name        String
  basisPoints Int?
  fixedMinor  Int?
  currency    String   @default("USD")
  productId   String?
  categoryId  String?
  effectiveFrom DateTime
  effectiveTo DateTime?
  createdAt   DateTime @default(now())
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  commissions CommissionLedger[]
  @@index([effectiveFrom, effectiveTo])
}

model CommissionLedger {
  id            String           @id @default(cuid())
  affiliateId   String
  orderItemId   String?
  ruleId        String?
  amountMinor   Int
  currency      String
  status        CommissionStatus @default(PENDING)
  entryType     CommissionEntryType @default(EARNED)
  eligibleBaseMinor Int
  ruleName      String?
  basisPointsSnapshot Int?
  fixedMinorSnapshot Int?
  idempotencyKey String          @unique
  sourceEventId String?
  reversalOfId String?
  reason        String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  affiliate     AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  orderItem     OrderItem?       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  rule          AffiliateCommissionRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  reversalOf    CommissionLedger? @relation("CommissionReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals     CommissionLedger[] @relation("CommissionReversal")
  payoutItems   AffiliatePayoutItem[]
  @@index([affiliateId, status, createdAt])
  @@index([orderItemId])
  @@index([sourceEventId])
  @@index([reversalOfId])
}

model AffiliatePayout {
  id          String               @id @default(cuid())
  affiliateId String
  amountMinor Int
  currency    String
  status      AffiliatePayoutStatus @default(REQUESTED)
  method      String?
  reference   String?
  reviewedById String?
  reviewedAt  DateTime?
  paidAt      DateTime?
  reviewNote  String?
  createdAt   DateTime             @default(now())
  affiliate   AffiliateProfile    @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  items       AffiliatePayoutItem[]
  @@index([affiliateId, status, createdAt])
}

model AffiliatePayoutItem {
  payoutId     String
  commissionId String
  amountMinor  Int
  payout       AffiliatePayout @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  commission   CommissionLedger @relation(fields: [commissionId], references: [id], onDelete: Restrict)
  @@id([payoutId, commissionId])
}

model AffiliateAdjustment {
  id              String                  @id @default(cuid())
  orderId         String
  orderItemId     String?
  type            AffiliateAdjustmentType
  quantity        Int?
  amountMinor     Int
  currency        String
  idempotencyKey  String                  @unique
  providerEventId String?
  reason          String?
  createdById     String?
  createdAt       DateTime                @default(now())
  order           ParentOrder             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem       OrderItem?              @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  @@index([orderId, createdAt])
  @@index([providerEventId])
}

model MarketingCampaign {
  id          String         @id @default(cuid())
  name        String
  status      CampaignStatus @default(DRAFT)
  placements  String[]
  contentJson Json
  priority    Int            @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdBy   User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  products    MarketingCampaignProduct[]
  @@index([status, startsAt, endsAt])
}

model MarketingCampaignProduct {
  campaignId String
  productId  String
  campaign   MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@id([campaignId, productId])
}

model Notification {
  id             String                    @id @default(cuid())
  userId         String
  channel        NotificationChannel       @default(IN_APP)
  eventType      String
  title          String
  body           String
  link           String?
  payloadJson    Json?
  deliveryStatus NotificationDeliveryStatus @default(PENDING)
  readAt         DateTime?
  createdAt      DateTime                  @default(now())
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
}

model NotificationPreference {
  id       String              @id @default(cuid())
  userId   String
  channel  NotificationChannel
  category String
  enabled  Boolean             @default(true)
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, channel, category])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model EmailOutbox {
  id              String                    @id @default(cuid())
  recipientEmail  String
  recipientUserId  String?
  templateKey     String
  payloadJson     Json
  idempotencyKey  String                    @unique
  status          NotificationDeliveryStatus @default(PENDING)
  attempts        Int                       @default(0)
  nextAttemptAt   DateTime                  @default(now())
  providerMessageId String?
  lastError       String?
  createdById     String?
  createdAt       DateTime                  @default(now())
  recipientUser   User?                     @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)
  @@index([status, nextAttemptAt])
}

model Conversation {
  id        String             @id @default(cuid())
  buyerId   String
  sellerId  String
  productId String?
  orderId   String?
  status    ConversationStatus @default(OPEN)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  buyer     User               @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller    Seller             @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  product   Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  order     ParentOrder?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages  Message[]
  @@index([buyerId, updatedAt])
  @@index([sellerId, updatedAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  attachmentId   String?
  sentAt         DateTime @default(now())
  readAt         DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  sender         User     @relation(fields: [senderId], references: [id], onDelete: Restrict)
  @@index([conversationId, sentAt])
}

model AiUsageLog {
  id          String   @id @default(cuid())
  userId      String?
  feature     String
  provider    String
  inputTokens Int?
  outputTokens Int?
  costMinor   Int?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([feature, createdAt])
}
