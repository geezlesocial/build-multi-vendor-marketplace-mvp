  sellerOrder     SellerOrder?     @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull)
  assignedAdmin   User?            @relation("SupportTicketAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  messages        SupportMessage[]

  @@index([buyerId, updatedAt])
  @@index([sellerId, status, updatedAt])
  @@index([status, priority, updatedAt])
  @@index([parentOrderId])
}

model SupportMessage {
  id         String        @id @default(cuid())
  ticketId   String
  authorId   String
  authorRole String        @db.VarChar(20)
  body       String        @db.VarChar(4000)
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author     User          @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

model AiUsageLog {
  id           String   @id @default(cuid())
  userId       String?
  feature      String
  provider     String
  inputTokens  Int?
  outputTokens Int?
  costMinor    Int?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([feature, createdAt])
}

model JimaConversation {
  id        String        @id @default(cuid())
  userId    String
  title     String        @db.VarChar(120)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  JimaMessage[]

  @@index([userId, updatedAt])
}

model SeofyAudit {
  id            String                @id @default(cuid())
  storeId       String
  createdById   String
  targetType    SeofyAuditTargetType
  targetId      String
  status        SeofyAuditStatus       @default(READY)
  aiStatus      SeofyAuditAiStatus     @default(NOT_CONFIGURED)
  learningUsed  Boolean                @default(false)
  sourceHash    String                @db.VarChar(64)
  findings      Json
  createdAt     DateTime              @default(now())
  appliedAt     DateTime?
  store         Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy     User                  @relation(fields: [createdById], references: [id], onDelete: Cascade)
  suggestions   SeofySuggestion[]

  @@index([storeId, createdAt])
  @@index([storeId, targetType, targetId, createdAt])
}

model SeofySuggestion {
  id               String                 @id @default(cuid())
  auditId          String
  field            SeofySuggestionField
  currentValue     String?                @db.VarChar(320)
  recommendedValue String                 @db.VarChar(320)
  rationale        String                 @db.VarChar(500)
  evidence         String                 @db.VarChar(500)
  status           SeofySuggestionStatus  @default(PENDING)
  createdAt        DateTime               @default(now())
  appliedAt        DateTime?
  audit            SeofyAudit             @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@unique([auditId, field])
  @@index([auditId, status])
}

model JimaMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           String           @db.VarChar(12)
  content        String           @db.VarChar(4000)
  createdAt      DateTime         @default(now())
  conversation   JimaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model JimaKnowledgeArticle {
  id        String   @id @default(cuid())
  title     String   @db.VarChar(160)
  body      String   @db.VarChar(8000)
  audience  String   @default("PUBLIC") @db.VarChar(16)
  published Boolean  @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([published, audience, updatedAt])
}

model JimaRuntimeMetric {
  bucketStart DateTime
  outcome     String   @db.VarChar(20)
  count       Int      @default(0)

  @@id([bucketStart, outcome])
  @@index([bucketStart])
}
