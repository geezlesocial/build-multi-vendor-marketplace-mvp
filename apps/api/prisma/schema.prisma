generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  SELLER
  CASHIER
  ADMIN
  CONTENT_EDITOR
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum StorePlanStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum StorePlanVersionStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
}

enum StorePlanAssignmentStatus {
  ACTIVE
  SUPERSEDED
  EXPIRED
  CANCELLED
}

enum StorePlanAssignmentSource {
  ADMIN
  LEGACY_BOOTSTRAP
  SUBSCRIPTION
}

enum StorePlanBillingInterval {
  MONTHLY
  ANNUAL
}

enum StorePlanExpirationBehavior {
  DOWNGRADE_TO_LEGACY
  SUSPEND_SELLER
}

enum StorePlanCancellationPolicy {
  CANCEL_ANYTIME
  CANCEL_AT_TERM_END
}

enum StoreSubscriptionStatus {
  PENDING
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  UNPAID
}

enum StoreSubscriptionProvider {
  STRIPE
  PAYPAL
}

enum StoreSubscriptionInvoiceStatus {
  OPEN
  PAID
  FAILED
  VOID
  REFUNDED
  PARTIALLY_REFUNDED
}

enum StoreSubscriptionEventStatus {
  RECEIVED
  APPLIED
  IGNORED
  FAILED
}

enum StoreThemePreset {
  CLASSIC
  EDITORIAL
  BOUTIQUE
}

enum StorePaymentConnector {
  STRIPE
  PAYPAL
}

enum MobileStorefrontTemplate {
  RESPONSIVE_STANDARD
  MOBILE_COMPACT
  MOBILE_EDITORIAL
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum PaymentMethod {
  STRIPE
  PAYPAL
  COD
  POS
}

enum IntegrationProvider {
  STRIPE
  PAYPAL
}

enum IntegrationContext {
  MARKETPLACE_CHECKOUT
  WALLET_FUNDING
}

enum IntegrationEnvironment {
  SANDBOX
  LIVE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  FULFILLED
  CANCELLED
}

enum LiveSessionStatus {
  DRAFT
  SCHEDULED
  STARTING
  LIVE
  PAUSED
  ENDED
  CANCELLED
  FAILED
}

enum LiveReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ContentPageType {
  STANDARD
  ABOUT
  TERMS
  PRIVACY
  POLICY
  HELP
  LANDING
}

enum NavigationPlacement {
  NONE
  HEADER
  FOOTER
  BOTH
}

enum MediaKind {
  IMAGE
  VIDEO
  CAPTION
  DOCUMENT
}

enum MediaScanStatus {
  QUARANTINED
  APPROVED
  REJECTED
}

enum MediaPurpose {
  GENERAL
  AVATAR
  PLATFORM_CONTENT
  PLATFORM_BRANDING
  STORE_MEDIA
}

enum MediaUploadStatus {
  PENDING
  VERIFYING
  COMPLETE
  FAILED
}

enum MediaStorageProvider {
  LOCAL
  OBJECT
}

enum StoreInterestSignalType {
  PRODUCT_VIEW
  SEARCH_CATEGORY
  FAVORITE
}

enum StoreBusterCampaignStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PAUSED
  ENDED
}

enum StoreBusterCampaignGoal {
  DISCOVERY
  PRODUCT_VIEWS
  STORE_VISITS
}

enum StoreEmailSubscriberStatus {
  PENDING_CONFIRMATION
  SUBSCRIBED
  UNSUBSCRIBED
  SUPPRESSED
  BOUNCED
}

enum StoreEmailCampaignStatus {
  DRAFT
  QUEUED
  SENT
  CANCELLED
}

enum AffiliateStatus {
  PENDING
  APPROVED
  REJECTED
  PAUSED
  TERMINATED
}
enum AffiliateAttributionRule {
  LAST_VALID_CLICK
  FIRST_VALID_CLICK
}
enum CommissionEntryType {
  EARNED
  REVERSAL
  ADJUSTMENT
}
enum AffiliateAdjustmentType {
  REFUND
  CHARGEBACK
  CANCELLATION
}
enum CommissionStatus {
  PENDING
  APPROVED
  REVERSED
  PAYABLE
  PAID
}
enum AffiliatePayoutStatus {
  REQUESTED
  APPROVED
  REJECTED
  PAID
}
enum WholesaleStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}
enum NotificationChannel {
  IN_APP
  EMAIL
  WEB_PUSH
  ANDROID_PUSH
}
enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SUPPRESSED
}
enum CampaignStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  PAUSED
  ARCHIVED
}
enum ConversationStatus {
  OPEN
  CLOSED
  BLOCKED
}

enum TaxonomyStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ApprovalPolicy {
  MANUAL
  AUTOMATIC
}

enum PayoutMethodType {
  MANUAL_BANK
  MANUAL_EWALLET
  STRIPE_CONNECT
  PAYPAL_PAYOUTS
}

enum PayoutMethodStatus {
  NOT_STARTED
  ACTION_REQUIRED
  READY
  DISABLED
}

enum SellerPayoutStatus {
  PENDING
  ELIGIBLE
  HELD
  REQUESTED
  APPROVED
  REJECTED
  SUBMITTED
  PROCESSING
  PAID
  FAILED
  RETURNED
  REVERSED
  CANCELLED
}

enum SellerPayoutLedgerType {
  SALE_FUNDING
  REFUND
  REVERSAL
  PLATFORM_FEE
  AFFILIATE_FUNDING
  ADJUSTMENT
}

enum WalletAccountType {
  USER
  TREASURY
}

enum WalletAccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum WalletLedgerStatus {
  POSTED
  REVERSED
}

enum WalletLedgerEntryType {
  FUNDING
  TRANSFER
  CHECKOUT
  REFUND
  CASHBACK
  WITHDRAWAL_RESERVE
  WITHDRAWAL_RELEASE
  ADJUSTMENT
  REVERSAL
}

enum WalletPostingDirection {
  DEBIT
  CREDIT
}

enum WalletBalanceState {
  AVAILABLE
  PENDING
  HELD
  FROZEN
}

enum WalletFundingStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REVERSED
  REVIEW
}

enum WalletTransferStatus {
  PENDING
  COMPLETED
  REJECTED
  FAILED
  REVERSED
}

enum WalletWithdrawalStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PROCESSING
  PAID
  FAILED
  RELEASED
}

enum ClubCoinAccountStatus {
  ACTIVE
  FROZEN
}

enum ClubCoinEntryType {
  AWARD
  REDEMPTION
  EXPIRY
  REVERSAL
  ADJUSTMENT
}

enum ClubCoinEventType {
  ACCOUNT_VERIFIED
  PURCHASE_COMPLETED
  REVIEW_SUBMITTED
  LIVE_ATTENDANCE
  CUSTOM
}

enum ClubCoinRedemptionStatus {
  RESERVED
  APPLIED
  REVERSED
  EXPIRED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  role         Role         @default(BUYER)
  avatarMediaId String?     @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  sessions     Session[]
  seller       Seller?
  auditLogs    AuditLog[]
  posSessions  POSSession[]
  orders       ParentOrder[] @relation("BuyerOrders")
  addresses    SavedAddress[]
  preference   UserPreference?
  staffMemberships SellerStaff[]
  cart         Cart?
  liveReports  LiveSessionReport[]
  reviewedLiveReports LiveSessionReport[] @relation("ReviewedLiveReports")
  authoredBlogPosts BlogPost[] @relation("BlogPostAuthors")
  editedBlogPosts BlogPost[] @relation("BlogPostEditors")
  editedContentPages ContentPage[]
  blogRevisions BlogPostRevision[]
  pageRevisions ContentPageRevision[]
  uploadedMedia MediaAsset[]
  avatarMedia MediaAsset? @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  contentAuditPreviews ContentPreviewToken[]
  slugRedirects SlugRedirect[]
  favorites Favorite[]
  affiliateProfile AffiliateProfile?
  wholesaleApplication WholesaleApplication?
  notifications Notification[]
  notificationPreferences NotificationPreference[]
  pushSubscriptions PushSubscription[]
  conversationsAsBuyer Conversation[] @relation("ConversationBuyer")
  sentMessages Message[]
  aiUsageLogs AiUsageLog[]
  createdCampaigns MarketingCampaign[]
  emailOutbox EmailOutbox[]
  platformBrandingRevisions PlatformBrandingRevision[]
  storeThemeRevisions StoreThemeRevision[]
  sellerAdminNotes SellerAdminNote[]
  sellerModerationEvents SellerModerationEvent[]
  payoutMethodsCreated SellerPayoutMethod[] @relation("PayoutMethodCreator")
  payoutLedgerEntriesCreated SellerPayoutLedgerEntry[] @relation("PayoutLedgerCreator")
  payoutRequestsCreated SellerPayout[] @relation("PayoutRequester")
  payoutReviews SellerPayout[] @relation("PayoutReviewer")
  brandingUpdates PlatformBranding[] @relation("BrandingUpdater")
  walletAccount WalletAccount?
  clubCoinAccount ClubCoinAccount?
  walletFundingIntents WalletFundingIntent[]
  walletTransfersSent WalletTransfer[] @relation("WalletTransferSender")
  walletTransfersReceived WalletTransfer[] @relation("WalletTransferRecipient")
  walletWithdrawalRequests WalletWithdrawalRequest[]
  clubCoinEntries ClubCoinEntry[]
  clubCoinRedemptions ClubCoinRedemption[]
  storeInterestSignals StoreInterestSignal[]
  reviewedStoreBusterCampaigns StoreBusterCampaign[] @relation("StoreBusterCampaignReviewer")
  storeBusterSettingsUpdates StoreBusterSettings[]
  clubCoinRulesCreated ClubCoinRule[] @relation("ClubCoinRuleCreator")
  storePlanVersionsCreated StorePlanVersion[] @relation("StorePlanVersionCreator")
  storePlanAssignmentsMade StorePlanAssignment[] @relation("StorePlanAssignmentAdmin")
  storePlanSubscriptionsRequested StoreSubscription[] @relation("StoreSubscriptionRequester")
  providerConfigurationsCreated ProviderConfiguration[] @relation("ProviderConfigurationCreator")
  providerConfigurationsUpdated ProviderConfiguration[] @relation("ProviderConfigurationUpdater")
}

model SavedAddress {
  id         String   @id @default(cuid())
  userId     String
  label      String
  line1      String
  line2      String?
  city       String
  region     String
  postalCode String
  country    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, isDefault, updatedAt])
}

model UserPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  language        String   @default("en")
  displayCurrency String   @default("USD")
  personalizationEnabled Boolean @default(false)
  personalizationConsentAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model Seller {
  id        String       @id @default(cuid())
  userId    String       @unique
  status    SellerStatus @default(PENDING)
  reason    String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  store     Store?
  products  Product[]
  staff     SellerStaff[]
  orders    SellerOrder[]
  posSessions POSSession[]
  liveSessions LiveSession[]
  affiliateLinks AffiliateLink[]
  conversations Conversation[] @relation("ConversationSeller")
  adminNotes SellerAdminNote[]
  moderationEvents SellerModerationEvent[]
  payoutMethods SellerPayoutMethod[]
  payoutLedgerEntries SellerPayoutLedgerEntry[]
  payouts SellerPayout[]
}

model Store {
  id          String @id @default(cuid())
  sellerId    String @unique
  name        String
  description String?
  slug        String @unique @default(cuid())
  logoMediaId String?
  bannerMediaId String?
  contactJson Json?
  policyLinksJson Json?
  themeDraftJson Json?
  themePublishedJson Json?
  themePublishedAt DateTime?
  seller      Seller @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  logoMedia MediaAsset? @relation("StoreLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  bannerMedia MediaAsset? @relation("StoreBanner", fields: [bannerMediaId], references: [id], onDelete: SetNull)
  themeRevisions StoreThemeRevision[]
  planAssignments StorePlanAssignment[]
  subscriptions   StoreSubscription[]
  blogPosts       BlogPost[]
  contentPages    ContentPage[]
  mediaAssets     MediaAsset[]
  storeBusterCampaigns StoreBusterCampaign[]
  emailSubscribers StoreEmailSubscriber[]
  emailCampaigns StoreEmailCampaign[]
  affiliateProgram StoreAffiliateProgram?
}

model SellerStaff {
  id                     String  @id @default(cuid())
  sellerId               String
  userId                 String
  canPos                 Boolean @default(true)
  canManageStoreBranding Boolean @default(false)
  seller                 Seller  @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  user                   User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([sellerId, userId])
}

model Category {
  id       String @id @default(cuid())
  name     String @unique
  slug     String @unique
  description String?
  imageUrl String?
  status TaxonomyStatus @default(ACTIVE)
  displayOrder Int @default(0)
  parentId String?
  parent Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]
  affiliateCommissionRules AffiliateCommissionRule[]
  interestSignals StoreInterestSignal[]
  @@index([parentId, status, displayOrder])
}

model Brand {
  id          String @id @default(cuid())
  name        String @unique
  slug        String @unique
  description String?
  imageUrl    String?
  status      TaxonomyStatus @default(ACTIVE)
  displayOrder Int @default(0)
  products    Product[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status, displayOrder])
}

model Product {
  id          String        @id @default(cuid())
  sellerId    String?
  categoryId  String?
  brandId     String?
  name        String
  slug        String        @unique
  description String
  priceMinor  Int
  currency    String        @default("USD")
  status      ProductStatus @default(PENDING)
  barcode     String?
  wholesaleEnabled Boolean @default(false)
  wholesaleMinQuantity Int?
  wholesalePackSize Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  seller      Seller?       @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand       Brand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images      ProductImage[]
  inventory   Inventory?
  cartItems   CartItem[]
  orderItems OrderItem[]
  liveSessionProducts LiveSessionProduct[]
  variants ProductVariant[]
  favorites Favorite[]
  wholesaleTiers WholesaleTierPrice[]
  affiliateLinks AffiliateLink[]
  affiliateClicks AffiliateClick[]
  affiliateCommissionRules AffiliateCommissionRule[]
  interestSignals StoreInterestSignal[]
  storeBusterCampaigns StoreBusterCampaignProduct[]
  campaignProducts MarketingCampaignProduct[]
  conversationProducts Conversation[]
  @@index([status, categoryId])
  @@index([sellerId, status])
  @@index([brandId, status])
  @@index([barcode])
}

model ProductImage {
  id            String @id @default(cuid())
  productId     String
  mediaAssetId  String?
  url           String
  alt           String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset    MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  @@index([mediaAssetId])
}

model Inventory {
  id        String @id @default(cuid())
  productId String @unique
  quantity  Int    @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  name        String
  sku         String   @unique
  priceMinor  Int
  currency    String   @default("USD")
  stock       Int      @default(0)
  status      ProductStatus @default(APPROVED)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  cartItems   CartItem[]
  orderItems  OrderItem[]
  wholesaleTiers WholesaleTierPrice[]
  @@index([productId, status])
}

model Cart {
  id        String @id @default(cuid())
  userId    String @unique
  updatedAt DateTime @updatedAt
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  variantId String?
  cart      Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  @@unique([cartId, productId])
  @@index([variantId])
}

model ParentOrder {
  id             String        @id @default(cuid())
  orderNumber    String        @unique
  buyerId        String?
  buyerEmail     String
  buyerName      String
  addressJson    Json
  totalMinor     Int
  currency       String
  status         OrderStatus   @default(PENDING)
  createdAt      DateTime      @default(now())
  affiliateClickId String? @unique
  buyer          User?         @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: SetNull)
  sellerOrders   SellerOrder[]
  conversations Conversation[]
  payment        Payment?
  affiliateClick AffiliateClick? @relation("AffiliateConversion", fields: [affiliateClickId], references: [id], onDelete: SetNull)
  affiliateAdjustments AffiliateAdjustment[]
  @@index([buyerId, createdAt])
}

model SellerOrder {
  id         String @id @default(cuid())
  parentId   String
  sellerId   String?
  status     OrderStatus @default(PENDING)
  totalMinor Int
  parent     ParentOrder @relation(fields: [parentId], references: [id], onDelete: Restrict)
  seller     Seller? @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  items      OrderItem[]
  payoutLedgerEntries SellerPayoutLedgerEntry[]
  @@index([sellerId, status])
}

model OrderItem {
  id            String @id @default(cuid())
  sellerOrderId String
  productId     String
  productName   String
  unitPriceMinor Int
  quantity      Int
  variantId     String?
  variantName   String?
  sellerOrder   SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  product       Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  affiliateCommissions CommissionLedger[]
  affiliateAdjustments AffiliateAdjustment[]
  payoutLedgerEntries SellerPayoutLedgerEntry[]
  @@index([variantId])
}

model Payment {
  id          String        @id @default(cuid())
  parentId    String        @unique
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  providerRef String?
  paidAt      DateTime?
  parent      ParentOrder @relation(fields: [parentId], references: [id], onDelete: Restrict)
  attempts    PaymentAttempt[]
  @@index([method, status])
}

model PaymentAttempt {
  id          String @id @default(cuid())
  paymentId   String
  provider    PaymentMethod
  providerRef String?
  idempotencyKey String?
  status      PaymentStatus
  metadata    Json?
  createdAt   DateTime @default(now())
  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  @@unique([provider, providerRef])
  @@index([idempotencyKey])
}

model ProcessedWebhookEvent {
  id         String @id @default(cuid())
  provider   PaymentMethod
  eventId    String
  receivedAt DateTime @default(now())
  eventType  String?
  reviewReason String?
  @@unique([provider, eventId])
  @@index([provider, reviewReason])
}

model MarketplaceSettings {
  id               String  @id @default("default")
  multiVendorEnabled Boolean @default(true)
  liveShoppingEnabled Boolean @default(false)
  affiliateEnabled Boolean @default(false)
  affiliateFundingConfigured Boolean @default(false)
  affiliateAttributionRule AffiliateAttributionRule @default(LAST_VALID_CLICK)
  affiliateAttributionWindowDays Int @default(30)
  affiliateMinimumPayoutMinor Int @default(0)
  codMaxMinor      Int?
  sellerApprovalPolicy ApprovalPolicy @default(MANUAL)
  productApprovalPolicy ApprovalPolicy @default(MANUAL)
  sellerPayoutsEnabled Boolean @default(false)
  payoutFundingConfigured Boolean @default(false)
  manualBankPayoutsEnabled Boolean @default(false)
  manualEwalletPayoutsEnabled Boolean @default(false)
  stripeConnectPayoutsEnabled Boolean @default(false)
  paypalPayoutsEnabled Boolean @default(false)
  payoutHoldDays Int @default(7)
  payoutMinimumMinor Int @default(0)
  walletEnabled Boolean @default(false)
  walletFundingEnabled Boolean @default(false)
  walletTransfersEnabled Boolean @default(false)
  walletCheckoutEnabled Boolean @default(false)
  walletWithdrawalsEnabled Boolean @default(false)
  walletEmergencyPause Boolean @default(true)
  clubCoinsEnabled Boolean @default(false)
  clubCoinsEarnEnabled Boolean @default(false)
  clubCoinsRedeemEnabled Boolean @default(false)
  clubCoinTransfersEnabled Boolean @default(false)
  clubCoinConversionEnabled Boolean @default(false)
  clubCoinRedemptionRatio Int @default(100)
  clubCoinMaxDiscountMinor Int @default(0)
  clubCoinName String @default("Club Coins")
  clubCoinIconUrl String?
  updatedAt         DateTime @updatedAt
}

model LiveSession {
  id                 String            @id @default(cuid())
  sellerId           String
  title              String
  description        String?
  coverImageUrl      String?
  scheduledAt        DateTime?
  timezone           String
  provider           String?
  providerSessionRef String?           @unique
  playbackRef        String?
  status             LiveSessionStatus @default(DRAFT)
  providerStatus     String?
  errorMessage       String?
  startedAt          DateTime?
  endedAt            DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  seller             Seller            @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  products           LiveSessionProduct[]
  reports            LiveSessionReport[]
  providerEvents     LiveProviderEvent[]
  @@index([status, scheduledAt])
  @@index([sellerId, status])
}

model LiveSessionProduct {
  id        String      @id @default(cuid())
  sessionId String
  productId String
  sortOrder Int
  featured  Boolean     @default(false)
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product   Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@unique([sessionId, productId])
  @@unique([sessionId, sortOrder])
  @@index([productId])
}

model LiveSessionReport {
  id         String           @id @default(cuid())
  sessionId  String
  reporterId String?
  reason     String
  status     LiveReportStatus @default(OPEN)
  reviewedById String?
  reviewedAt DateTime?
  createdAt  DateTime         @default(now())
  session    LiveSession      @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  reporter   User?            @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  reviewedBy User?            @relation("ReviewedLiveReports", fields: [reviewedById], references: [id], onDelete: SetNull)
  @@index([sessionId, status, createdAt])
}

model LiveProviderEvent {
  id         String      @id @default(cuid())
  provider   String
  eventId    String
  sessionId  String?
  eventType  String
  payloadJson Json?
  receivedAt DateTime    @default(now())
  session    LiveSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  @@unique([provider, eventId])
  @@index([sessionId, receivedAt])
}

model PaymentMethodSettings {
  id        String @id
  method    PaymentMethod @unique
  enabled   Boolean @default(false)
  updatedAt DateTime @updatedAt
}

model ProviderConfiguration {
  id             String                   @id @default(cuid())
  provider       IntegrationProvider
  context        IntegrationContext
